__pycache__/
*.py[cod]
.venv/
# large regenerable assets of the visual study (image pools, replay stores, resume checkpoints)
visual/runs/**/*.pt
visual/runs/**/*.npz
visual/runs/**/*.pkl
visual/runs/**/*.tmp
# archived weights and fixed audit samples that ARE part of the delivered records
!visual/runs/pretrain_v4/encoder.pt
!visual/runs/pretrain_v4/audit_set.npz
!visual/runs/v4r/common/common_nets.pt
!visual/runs/v4r*/v4_pilot/*/final_nets.pt
!visual/runs/v4r*/v4_pilot/*/evaluation_traces/*.npz
!visual/runs/v5_timing/frozen_state.pkl
!visual/runs/v5_timing/frozen_state_v16.pkl
long_route/evsim_v9/out/*
!long_route/evsim_v9/out/.gitkeep
long_route/evsim_v9/logs/*
!long_route/evsim_v9/logs/.gitkeep
